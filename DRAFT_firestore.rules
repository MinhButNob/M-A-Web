rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['name', 'email', 'role', 'isVerified']) &&
               data.keys().size() >= 4 &&
               data.name is string && data.name.size() <= 200 &&
               data.email is string && data.email.size() <= 200 &&
               data.role in ['buyer', 'seller', 'advisor', 'admin'] &&
               data.isVerified is bool;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role != 'admin' && incoming().isVerified == false;
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) &&
                       incoming().role == existing().role &&
                       incoming().email == existing().email &&
                       incoming().isVerified == existing().isVerified;
    }

    // --- Deals ---
    match /deals/{dealId} {
      function isValidDeal(data) {
        return data.keys().hasAll(['title', 'ownerId', 'industry', 'status']) &&
               data.title is string && data.title.size() <= 300 &&
               data.ownerId is string && data.ownerId == request.auth.uid &&
               data.industry is string && data.industry.size() <= 100 &&
               data.status in ['published', 'under-review', 'closed'];
      }

      allow list: if isSignedIn() && (resource.data.status == 'published' || resource.data.ownerId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.status == 'published' || resource.data.ownerId == request.auth.uid);
      
      allow create: if isSignedIn() && isValidDeal(incoming());
      allow update: if isOwner(existing().ownerId) && isValidDeal(incoming()) && 
                       existing().status != 'closed' &&
                       incoming().ownerId == existing().ownerId &&
                       (
                         // Action: General Update
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'industry', 'location', 'revenue', 'ebitda', 'valuation', 'growth', 'type', 'description', 'status', 'updatedAt'])
                       );
      allow delete: if isOwner(existing().ownerId) && existing().status != 'closed';
    }
  }
}
